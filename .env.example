# ============================================================
# AnGIneer 部署环境变量配置
# 复制此文件为 .env 并填写实际值：cp .env.example .env
# ============================================================

# --- AI Provider (可选: aliyun) ---
AI_PROVIDER=aliyun

# 默认模型 (config_name 未指定时使用)
ANGINEER_DEFAULT_MODEL=Qwen3.6-Plus

# 评测判分专用模型（judge 与被测解耦，见 README「评测判分」节）。
# 值 = LLM_CONFIGS 中的配置 name；不设置则语义判分用默认模型（自评，不推荐用于跨精度对比）。
# EVAL_JUDGE_MODEL=Qwen3.8-Flash-Judge

# ============================================================
# LLM 模型配置 (JSON 格式，唯一配置入口)
# 新增/修改模型只需编辑这里，无需改代码
# 格式: [{"name": "显示名", "model": "模型ID", "api_key": "密钥", "base_url": "API地址", "priority": 优先级}]
# ============================================================
LLM_CONFIGS=[{"name": "Qwen3.6-35B-A3B", "model": "Qwen3.6-35B-A3B-FP8", "api_key": "YOUR_API_KEY", "base_url": "https://your-private-api.com/chat/v1", "priority": 10}, {"name": "Qwen2.5-7B", "model": "Qwen/Qwen2.5-7B-Instruct", "api_key": "YOUR_API_KEY", "base_url": "https://api.siliconflow.cn/v1", "priority": 9}, {"name": "Nemotron-30B", "model": "nvidia/nemotron-3-nano-30b-a3b", "api_key": "YOUR_API_KEY", "base_url": "https://integrate.api.nvidia.com/v1", "priority": 8}, {"name": "Qwen3-4B(付费)", "model": "qwen3-4b", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 7}, {"name": "Qwen3.6-Plus(付费)", "model": "qwen3.6-plus", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 6}, {"name": "DeepseekV4-Pro(付费)", "model": "deepseek-v4-pro", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 5}, {"name": "DeepseekV4-Flash(付费)", "model": "deepseek-v4-flash", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 4}]

# ============================================================
# 文档解析 - MinerU（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 格式: [{"name": "端点名", "url": "API地址(可写 base，自动补 /file_parse)", "api_key": "密钥"}]
# ============================================================
MINERU_CONFIGS=[{"name": "company", "url": "https://ai.bim-ace.com:50170/file_parse", "api_key": "YOUR_MINERU_API_KEY"}]
# MinerU 并发上限：同一时刻最多 N 个 MinerU 任务占用 GPU（默认 1，建议保持 1）
MINERU_MAX_CONCURRENCY=1

# ============================================================
# MinerU-Popo 后处理（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 格式: [{"name": "端点名", "url": "API地址", "api_key": "密钥", "model": "模型名"}]
# ============================================================
POPO_CONFIGS=[{"name": "company", "url": "https://ai.bim-ace.com/mineru-popo/v1", "api_key": "YOUR_POPO_API_KEY", "model": "MinerU-Popo"}]
# PoPo 4B 推理并发上限：同一时刻最多 N 个任务打远端 vLLM（默认 1，建议保持 1）
POPO_MAX_CONCURRENCY=1
# 图描述 VLM 并发上限：同一时刻最多 N 个任务打远端 chat 端点。默认 1（严格按提交序号先来先服务）；
# 调大会放宽该顺序，让多篇文档的图描述并行，代价是同时压 VLM 端点。
FIGURE_DESCRIBE_MAX_CONCURRENCY=2
# PoPo 推理瞬时失败（超时/连接类）重试次数（默认 1）
POPO_INFERENCE_RETRIES=1

# ============================================================
# 文档向量解析 - Embedding（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 链尾自动补 hash 档兜底；DOCS_EMBEDDING_PROVIDER=hash 时仅用本地 hash（无语义模式）。
# ============================================================
# Provider: bge_m3 | dashscope | hash（仅 hash 有语义区分；其余名称仅作标识）
DOCS_EMBEDDING_PROVIDER=bge_m3
# 向量存储: sqlite（推荐，默认）| chroma（chroma 数据损坏时进程级崩溃，恢复前勿用）
DOCS_VECTORSTORE_PROVIDER=sqlite
# EMBEDDING_CONFIGS=[{"name": "company", "model": "bge-m3", "api_key": "YOUR_EMBEDDING_API_KEY", "api_url": "https://ai.bim-ace.com/bge/v1"}, {"name": "local", "model": "bge-m3", "api_key": "not-needed", "api_url": "http://localhost:7997/v1"}]
# 严格模式（true 时禁止任何降级，失败直接抛错）
# DOCS_EMBEDDING_STRICT_FALLBACK=false
# 向量索引单批文本数（默认 32；DGX qwen3-embedding 批内亚线性，建议 64；本地 TEI 保持 ≤32 防 413）
# DOCS_EMBEDDING_BATCH_SIZE=32
# 向量索引批次并发度（默认 1=串行；DGX qwen3-embedding 对并发排队执行、并发反而更慢，
# 仅多 worker 的本地 TEI 类端点才值得调大）
# DOCS_EMBEDDING_BATCH_CONCURRENCY=1

# ============================================================
# Reranker 在线 API（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# URL 可省略 /v1/rerank 后缀，会自动补全
# ============================================================
RERANKER_CONFIGS=[{"name": "company", "url": "https://ai.bim-ace.com/bge-reranker", "api_key": "YOUR_RERANKER_API_KEY"}]

# --- 日志级别 ---
LOG_LEVEL=INFO

# ============================================================
# 部署相关
# ============================================================
# CORS 允许的来源（逗号分隔），生产环境需加上服务器 ip/域名
# ALLOWED_ORIGINS=http://localhost,https://angineer.cn

# API Key 数据库路径（默认 data/api_keys.sqlite）
# API_KEYS_DB_PATH=/app/data/api_keys.sqlite

# 管理端 Basic Auth 密码（可选；未设置时 deploy.sh --prepare 自动生成随机密码）
# ADMIN_PASSWORD=change-me

# ONLYOFFICE 文档服务器 JWT 密钥（onlyoffice 服务通过 env_file 注入，镜像要求变量名为 JWT_SECRET）
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# 企微 Webhook 通知（多群支持，逗号分隔多个 URL）
# ============================================================
# 部署通知（GitHub Actions 部署完成/失败时发送）
WEBHOOK_DEPLOY=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_DEPLOY_KEY
# 系统维护（配置校验、夜间测试、系统报错等）
WEBHOOK_SYSTEM=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_SYSTEM_KEY
# 业主通知（夜间测试结果）
WEBHOOK_OWNER=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_OWNER_KEY

# ============================================================
# Qdrant 向量库（DOCS_VECTORSTORE_PROVIDER=qdrant 时生效；sqlite 为当前默认）
# docker compose 部署：后端容器经内网 service 名访问，QDRANT_URL=http://qdrant:6333
# 本地开发（无 docker 网络）：先起容器 docker run -d -p 6333:6333 qdrant/qdrant:v1.19.0，
# 然后 QDRANT_URL=http://localhost:6333
# ============================================================
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=docs_core_vectors
# QDRANT_TIMEOUT=60
# QDRANT_API_KEY=（内网部署留空）
# 存量数据迁移：python scripts/migrate_vectors_to_qdrant.py --yes（容器内 /app/scripts/ 下）
# 双跑一致性校验：python scripts/verify_qdrant_parity.py（验收线 content recall@20 >= 0.95）

# ============================================================
# 评测判分引擎（v0.2.47 起；默认 legacy 自研 prompt 判分，deepeval 换为 DeepEval 指标层）
# EVAL_ENGINE=deepeval 时由 GEval/Faithfulness/AnswerRelevancy/ContextualPrecision 接管判分，
# judge 候选链纪律（EVAL_JUDGE_CONFIGS/EVAL_JUDGE_MODEL）与关键词兜底语义不变。
# ============================================================
# EVAL_ENGINE=legacy
# EVAL_DEEPVAL_EXTRA=1  # 0=关闭扩展维度（每题省 3~6 次 judge 调用，nightly 提速）
