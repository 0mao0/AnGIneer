# ============================================================
# AnGIneer 部署环境变量配置
# 复制此文件为 .env 并填写实际值：cp .env.example .env
# ============================================================

# --- AI Provider (可选: aliyun) ---
AI_PROVIDER=aliyun

# 默认模型 (config_name 未指定时使用)
ANGINEER_DEFAULT_MODEL=Qwen3.6-Plus

# 评测判分专用模型（judge 与被测解耦，见 README「评测判分」节）。
# 值 = LLM_CONFIGS 中的配置 name；不设置则语义判分用默认模型（自评，不推荐用于跨精度对比）。
# EVAL_JUDGE_MODEL=Qwen3.8-Flash-Judge

# ============================================================
# LLM 模型配置 (JSON 格式，唯一配置入口)
# 新增/修改模型只需编辑这里，无需改代码
# 格式: [{"name": "显示名", "model": "模型ID", "api_key": "密钥", "base_url": "API地址", "priority": 优先级}]
# ============================================================
LLM_CONFIGS=[{"name": "Qwen3.6-35B-A3B", "model": "Qwen3.6-35B-A3B-FP8", "api_key": "YOUR_API_KEY", "base_url": "https://your-private-api.com/chat/v1", "priority": 10}, {"name": "Qwen2.5-7B", "model": "Qwen/Qwen2.5-7B-Instruct", "api_key": "YOUR_API_KEY", "base_url": "https://api.siliconflow.cn/v1", "priority": 9}, {"name": "Nemotron-30B", "model": "nvidia/nemotron-3-nano-30b-a3b", "api_key": "YOUR_API_KEY", "base_url": "https://integrate.api.nvidia.com/v1", "priority": 8}, {"name": "Qwen3-4B(付费)", "model": "qwen3-4b", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 7}, {"name": "Qwen3.6-Plus(付费)", "model": "qwen3.6-plus", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 6}, {"name": "DeepseekV4-Pro(付费)", "model": "deepseek-v4-pro", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 5}, {"name": "DeepseekV4-Flash(付费)", "model": "deepseek-v4-flash", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 4}]

# ============================================================
# 文档解析 - MinerU（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 格式: [{"name": "端点名", "url": "API地址(可写 base，自动补 /file_parse)", "api_key": "密钥"}]
# ============================================================
MINERU_CONFIGS=[{"name": "company", "url": "https://ai.bim-ace.com:50170/file_parse", "api_key": "YOUR_MINERU_API_KEY"}]
# MinerU 并发上限：同一时刻最多 N 个 MinerU 任务占用 GPU（默认 1，建议保持 1）
MINERU_MAX_CONCURRENCY=1
# MinerU company 端点 API 超时（秒，默认 600）：大册扫描件解析可合法超 600s，客户端超时掐活任务→重试双烧 GPU（2026-10-04 OfficeQA 入库实测）
MINERU_COMPANY_API_TIMEOUT=600

# ============================================================
# MinerU-Popo 后处理（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 格式: [{"name": "端点名", "url": "API地址", "api_key": "密钥", "model": "模型名"}]
# ============================================================
POPO_CONFIGS=[{"name": "dgx", "url": "https://angineer.cn/api/popo/v1", "api_key": "YOUR_POPO_API_KEY", "model": "Popo"}]
# PoPo 4B 推理并发上限：同一时刻最多 N 个任务打远端 vLLM（默认 1）。
# 2026-09-30 生产实测提到 4：DGX 显存/队列余量充足（84/122G、排队 0ms），批量入库提速明显。
# 注意：并发上去后单请求延迟拉长，POPO 客户端超时（POPO_API_TIMEOUT=900s+重试0）须按新 p99 复核；
# 且该端点与生产对话共享，业务高峰期保持低并发。
POPO_MAX_CONCURRENCY=4
# ============================================================
# 图描述 VLM（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 格式: [{"name": "端点名", "url": "完整 chat/completions 地址", "api_key": "密钥", "model": "模型名(必填)"}]
# 端点必须具备视觉能力（图像输入）；不配置则图描述阶段报错（不再内置任何默认端点）
# ============================================================
FIGURE_DESCRIBE_CONFIGS=[{"name": "dgx", "url": "https://angineer.cn/api/llm/chat/completions", "api_key": "YOUR_LLM_API_KEY", "model": "qwen3.6-35b"}, {"name": "company", "url": "https://ai.bim-ace.com/chat/v1/chat/completions", "api_key": "YOUR_CHAT_API_KEY", "model": "Qwen3.6-35B-A3B-FP8"}]
# 图描述 VLM 并发上限：同一时刻最多 N 个任务打远端 chat 端点。默认 1（严格按提交序号先来先服务）；
# 调大会放宽该顺序，让多篇文档的图描述并行，代价是同时压 VLM 端点。
FIGURE_DESCRIBE_MAX_CONCURRENCY=2
# PoPo 推理瞬时失败（超时/连接类）重试次数（默认 1）
POPO_INFERENCE_RETRIES=1

# ============================================================
# 文档向量解析 - Embedding（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# 链尾自动补 hash 档兜底；DOCS_EMBEDDING_PROVIDER=hash 时仅用本地 hash（无语义模式）。
# ============================================================
# Provider: bge_m3 | dashscope | hash（仅 hash 有语义区分；其余名称仅作标识）
DOCS_EMBEDDING_PROVIDER=bge_m3
# 向量存储: qdrant（生产/本地开发定版）| sqlite | chroma
# 必填（旧默认 chroma 已移除）：未配置或值不认识时进程启动即报错，不再静默回退空库
DOCS_VECTORSTORE_PROVIDER=qdrant
# EMBEDDING_CONFIGS=[{"name": "company", "model": "bge-m3", "api_key": "YOUR_EMBEDDING_API_KEY", "api_url": "https://ai.bim-ace.com/bge/v1"}, {"name": "local", "model": "bge-m3", "api_key": "not-needed", "api_url": "http://localhost:7997/v1"}]
# 严格模式（true 时禁止任何降级，失败直接抛错）
# DOCS_EMBEDDING_STRICT_FALLBACK=false
# 向量索引单批文本数（默认 32；DGX qwen3-embedding 批内亚线性，建议 64；本地 TEI 保持 ≤32 防 413）
# DOCS_EMBEDDING_BATCH_SIZE=32
# 向量索引批次并发度（默认 1=串行；DGX qwen3-embedding 对并发排队执行、并发反而更慢，
# 仅多 worker 的本地 TEI 类端点才值得调大）
# DOCS_EMBEDDING_BATCH_CONCURRENCY=1

# ============================================================
# Reranker 在线 API（唯一配置入口，数组顺序=优先级，第一项默认；失败自动切下一项）
# URL 可省略 /v1/rerank 后缀，会自动补全
# ============================================================
RERANKER_CONFIGS=[{"name": "company", "url": "https://ai.bim-ace.com/bge-reranker", "api_key": "YOUR_RERANKER_API_KEY"}]

# LLM 二排（在线 rerank 成功后叠加：wide pass 重排 top-N + duel 复核才允许换掉第 1 名；
# 走 LLM_CONFIGS 默认模型；replay 投影 hit@1(sec) 0.785→0.838；默认关）
ANGINEER_LLM_SECOND_RERANK=0
# 二排窗口条数 / wide pass 单条截断字数 / duel 单条截断字数（一般不调）
#ANGINEER_LLM_SECOND_RERANK_TOP_N=15
#ANGINEER_LLM_SECOND_RERANK_MAX_CHARS=1500
#ANGINEER_LLM_SECOND_RERANK_DUEL_MAX_CHARS=4000

# --- 日志级别 ---
LOG_LEVEL=INFO

# ============================================================
# 部署相关
# ============================================================
# CORS 允许的来源（逗号分隔），生产环境需加上服务器 ip/域名
# ALLOWED_ORIGINS=http://localhost,https://angineer.cn

# API Key 数据库路径（默认 data/platform/api_keys.sqlite）
# API_KEYS_DB_PATH=/app/data/platform/api_keys.sqlite

# 管理端 Basic Auth 密码（可选；未设置时 deploy.sh --prepare 自动生成随机密码）
# ADMIN_PASSWORD=change-me

# ONLYOFFICE 文档服务器 JWT 密钥（onlyoffice 服务通过 env_file 注入，镜像要求变量名为 JWT_SECRET）
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# 企微 Webhook 通知（多群支持，逗号分隔多个 URL）
# ============================================================
# 部署通知（GitHub Actions 部署完成/失败时发送）
WEBHOOK_DEPLOY=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_DEPLOY_KEY
# 系统维护（配置校验、夜间测试、系统报错等）
WEBHOOK_SYSTEM=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_SYSTEM_KEY
# 业主通知（夜间测试结果）
WEBHOOK_OWNER=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_OWNER_KEY

# ============================================================
# Qdrant 向量库（DOCS_VECTORSTORE_PROVIDER=qdrant 时生效）
# docker compose 部署：后端容器经内网 service 名访问，QDRANT_URL=http://qdrant:6333
# 本地开发（无 docker 网络）：先起容器 docker run -d -p 6333:6333 qdrant/qdrant:v1.19.0，
# 然后 QDRANT_URL=http://localhost:6333
# ============================================================
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=docs_core_vectors   # 回退默认值：库组注册表（data/registry.sqlite）未登记
                                       # 的库才用它；已登记库的 collection 由注册表直出
# QDRANT_TIMEOUT=60
# QDRANT_API_KEY=（内网部署留空）
# ANGINEER_REGISTRY_DB=（可选）库组注册表路径覆盖，默认 data/registry.sqlite
# 存量数据迁移：python scripts/migrate_vectors_to_qdrant.py --yes（容器内 /app/scripts/ 下）
# 双跑一致性校验：python scripts/verify_qdrant_parity.py（验收线 content recall@20 >= 0.95）
# 库组拆桶（plan-kb-split-groups 阶段一）：seed_library_registry.py → split_qdrant_collections.py
#   --yes → --verify → seed --flip → split --delete-source

# ============================================================
# 评测判分引擎（v0.2.47 起；默认 legacy 自研 prompt 判分，deepeval 换为 DeepEval 指标层）
# EVAL_ENGINE=deepeval 时由 GEval/Faithfulness/AnswerRelevancy/ContextualPrecision 接管判分，
# judge 候选链纪律（EVAL_JUDGE_CONFIGS/EVAL_JUDGE_MODEL）与关键词兜底语义不变。
# ============================================================
# EVAL_ENGINE=legacy
# EVAL_DEEPVAL_EXTRA=1  # 0=关闭扩展维度（每题省 3~6 次 judge 调用，nightly 提速）

# ============================================================
# 问答意图路由与性能开关（索引见 docs/req-intent-classify-latency.md §7；
# 全部有代码默认值，不取消注释即按默认行为跑。完整语义以定义处 docstring 为准。
# 生产改 env 后必须 cd docker && docker compose up -d <服务> 重建容器——
# restart 不读新 env（09-25 实踩）
# ============================================================
# ANGINEER_ROUTE_PARALLEL=true         # 赌博式预检总闸（默认开；开=分类与首轮检索并行、命中 memo 免检索，关=纯串行）
# ANGINEER_MEMO_INFLIGHT=1             # memo 三态在途登记+等待（默认开；=0 回退旧「只存成品」行为，主路撞预检在途会自跑第二份）
# ANGINEER_MEMO_WAIT_BUDGET_SEC=       # 主路等待预检预算覆盖（默认=Σ各 rerank 端点超时+召回余量 6s，硬顶 90s）
# ANGINEER_IDLE_KEEPWARM=1             # 空闲保温探针（默认开；每 N 秒一条固定轻查询走 dense+sparse+rerank 全链防冷启动税）
# ANGINEER_KEEPWARM_INTERVAL_SEC=300   # 保温间隔秒数（最小 30）
# ANGINEER_KEEPWARM_QUERY=             # 保温查询词覆盖（默认「规范 设计」高频词；勿用索引外自描述词——FTS5 隐式 AND 会整条清零致探针空转）
# ANGINEER_CLAUSE_FASTPATH=true        # 条款号问句规则直达 L2（默认开；=false 回 LLM 分类）
# ANGINEER_SOP_CACHE_TTL=300           # SOP 进程内缓存秒数（0=停用，回每请求全量重读）
# ANGINEER_OPS_DISABLE=                # 观测落盘总开关（设 1 停用 data/ops/*.jsonl 落盘）
# ANGINEER_OPS_DIR=data/ops            # 观测 jsonl 目录覆盖（主仓库树外默认不落盘，须显式给目录才写）
# ANGINEER_REPO_ROOT=                  # 主仓库根显式指定（docs-core 用；默认向上探测 apps/+services/+package.json，独立安装的 wheel 里探测不到）
# ANGINEER_INJECT_FOLLOWUP_CHARS=15    # 短问跟进检索词改写阈值（赌博式预检沿用同一阈值跳过短问）
# ANGINEER_TABLE_TEXT_CACHE=1          # 表格检索归一化产物按表缓存（默认开；=0 回每查询重复归一化；纯记忆化不改候选集，req-table-retrieval-latency §9.5）
# ANGINEER_TABLE_ROW_AGG=0             # 表格行级候选按表聚合（默认关；=1 每表只留最相关一行，候选 1.2万→千级；改候选分布，nightly 对照后再定默认，同上 §9.5）
# ANGINEER_SPECULATIVE_SKIP_TABLE=1   # 赌博式预检跳过表题（默认开；=0 回旧行为照发预检——表题 memo 结构性不命中，白扫全库表还 GIL 互拖，同上 §11）
# ANGINEER_EVIDENCE_GRADE=1            # 证据相关性标注（默认开；=0 去掉每条证据的【相关性 档 分】标签——回退需同时 ANGINEER_QA_PROMPT_VERSION=v10，拒答归因方案①）
# ANGINEER_EVIDENCE_GRADE_LOW=0.25     # 相关性「低」阈值（低于即不得作为结论依据；校准期可调）
# ANGINEER_EVIDENCE_GRADE_HIGH=0.6     # 相关性「高」阈值（≥即高；中=两阈值之间）
# ANGINEER_NO_RELOAD=1                 # 本地 dev 关 uvicorn 热重载（docs-api/aichat-api；默认 0=文件改动即重启 worker——评测/补跑数小时长任务会被一次保存掐死，dev 边改码边跑评测时设 1，改完代码手动重启生效；服务器容器命令写死无 --reload，此键无效）
# ANGINEER_QA_BUDGET_TOKENS_EST=16000  # QA 档 prompt 预算闸（est=字符数//2；req-chat-history-bloat A-min 由 30000 收紧至 16000——ops 回归 real/est p99=1.46，16k est≈23.4k real 对 25k 验收线留余量；0=关闭回退）
# —— LLM 客户端超时/重试（ai_inference.load_llm_config_from_env；2026-10-04 重定，代码默认 TOTAL=20/READ=30 只够短生成，英文长生成必空转——squad2 实锤 590 次 Request timed out）——
# ANGINEER_TIMEOUT_READ=600            # 两次收包间隔上限秒数（流式=生成段挂起判定线；生产需 ≤ 网关 proxy_read_timeout）
# ANGINEER_TIMEOUT_TOTAL=600           # 整请求总时限（openai client total 语义：含首字等待+全部生成；必须 ≥ READ，否则 read 永不生效）
# ANGINEER_MAX_RETRIES=0               # SDK 级重试（挂起型故障重试只翻倍延迟；瞬时 5xx 由网关 backup upstream 兜，默认置 0）
# ANGINEER_CHAT_BUDGET_TOKENS_EST=12000 # L0 闲聊档预算闸（默认 12000；闲聊轮不再背历史检索证据——73k prompt 重灾区修复；0=关闭回退）
# ANGINEER_COMPLEX_BUDGET_TOKENS_EST=24000 # complex 档预算闸（由 100000 重估至 24000，独立于 QA 档——SOP 长 run 需证据余量；0=关闭回退）
# ANGINEER_MAX_CHAT_LIBRARIES=5        # 多库勾选上限（阶段三 /api/chat/agent 集合问答；默认 5，夹 1..10——先整集鉴权后截断，cap 外越权成员不随截断豁免）
# ANGINEER_FIRST_TOKEN_LIVENESS_S=90   # LLM 流式首字存活线秒数（默认 90；首字前挂起超该时长即放弃拉流按异常收口——挂起时用户等待从 read 超时 600s 收到 90s，停止按钮等待期同时收到约 1s；=0 禁用回纯 read 超时兜底。动机：2026-10-04 squad2 一题挂起 90 分钟，连接活着但永不回数据，__next__ 阻塞使超时与 cancel 双双失效）
# ANGINEER_NUMERIC_TAIL_LINE=1         # 数值题集（OfficeQA 类）判分答案提取器开关（默认关=官方全文直判口径；开=先提取「尾行候选」再过官方形态闸+数值比对——防「答案对但被推理外壳拖累」误杀，代价=可能把推理过程里的错数字捞进判定，2026-10-07 试点实锤 2 例。开启须重启 aichat-api 生效，评测与 chat 共用默认档）
# —— 知识库拆分/合并体量看板（kb-split-merge §5.10，2026-10-06）——
# ANGINEER_KB_SPLIT_HINT_DOCS=1000     # 拆分建议阈值：单库文档数（默认 1000 篇）
# ANGINEER_KB_SPLIT_HINT_VECTORS=1500000 # 拆分建议阈值：单库向量数（默认 150 万）
# ANGINEER_KB_SPLIT_HINT_DISK_GB=5     # 拆分建议阈值：单库磁盘占用 GB（默认 5）


# ============================================================
# 证据上桌（LLM 定员出 listA）与上下文硬帽（plan-evidence-admission，2026-10-04）
# 动因：10-04 nightly 9 题上下文超限 400→自动拒答（输入 61,441+输出 4,096 > 65,536，≈0.87pp/晚）。
# 三层防线：LLM 上桌定员（主）→ 装配末端软帽（fail-open 兜底）→ llm_client 400 钳制（最后防线）。
# 上桌只管 knowledge_search 文本条目；table/entity 只走软帽。判 0 且 rerank≥0.3 吵架保留、
# rerank≥0.6 头部豁免、判官异常 fail-open 全量放行；留痕进 all_scores.retrieval.admission。
# ============================================================
# ANGINEER_ADMISSION_MODE=oversize     # 上桌触发模式：oversize（默认；仅帽前 est>触发阈值的病态包走上桌）| all（全部检索走上桌——误杀/延迟风险，A/B 判据过线才许设默认）| off（逃生口）
# ANGINEER_ADMISSION_TRIGGER_EST=90000 # oversize 档触发阈值（帽前口径 est=字符数//2，即原始 top15 体积；90k est≈180k 字符）
# ANGINEER_ADMISSION_LLM_CONFIG=Qwen3.8-Flash-Next # 上桌判官（LLM_CONFIGS 的 name；默认对齐 llm2 条目 qwen3.8-flash-next 关思考。不复用 EVAL_JUDGE_MODEL——跨包读取违反模块解耦红线；缺名即 fail-open 全量放行）
# ANGINEER_ADMISSION_EXCERPT_CHARS=1000 # 判官输入每条摘录上限（字符）
# ANGINEER_EVIDENCE_CAP_EST=80000      # 证据体积软帽（est=字符数//2；装配公共末端、全部检索 kind；按 rank 装填、超帽截尾、剩余预算<200 字符整条丢；0=关帽。est 对中文低估约 2x，精确顶由 400 钳制兜底）
# ANGINEER_LLM_EVIDENCE_DEDUP=1        # LLM 投影去重（edaaf7d）：tool result 进 prompt 前剔 evidences[]（与 items[] 全文重复）；raw/meta 通道原样留评测。0=回退双份
# ANGINEER_LLM_SHELL_STRIP=1           # LLM 投影 V2（2026-10-05）：items[] 逐条只留 text/title/rerank_score + cite/page_label（metadata 提升顶层）；检索器遥测外壳（fusion_*/table_*/score 系/item_id 等，实测占 tool result 53%）不进 prompt、走 raw/meta 供评测。0=回退全量外壳
# ANGINEER_BUDGET_STOPPER_EST=120000   # 循环停止线（est；原硬编码 120000，P2 env 化——换小上下文模型时随 .env 调不裸奔）
