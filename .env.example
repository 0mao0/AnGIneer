LLM_CONFIGS=[{"name": "Qwen3.6-35B-A3B", "model": "Qwen3.6-35B-A3B-FP8", "api_key": "YOUR_API_KEY", "base_url": "https://your-private-api.com/chat/v1", "priority": 10}, {"name": "Qwen2.5-7B", "model": "Qwen/Qwen2.5-7B-Instruct", "api_key": "YOUR_API_KEY", "base_url": "https://api.siliconflow.cn/v1", "priority": 9}, {"name": "Nemotron-30B", "model": "nvidia/nemotron-3-nano-30b-a3b", "api_key": "YOUR_API_KEY", "base_url": "https://integrate.api.nvidia.com/v1", "priority": 8}, {"name": "Qwen3-4B(浠樿垂)", "model": "qwen3-4b", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 7}, {"name": "Qwen3.6-Plus(浠樿垂)", "model": "qwen3.6-plus", "api_key": "YOUR_API_KEY", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "priority": 6}, {"name": "DeepseekV4-Pro(浠樿垂)", "model": "deepseek-v4-pro", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 5}, {"name": "DeepseekV4-Flash(浠樿垂)", "model": "deepseek-v4-flash", "api_key": "YOUR_API_KEY", "base_url": "https://api.deepseek.com", "priority": 4}]

