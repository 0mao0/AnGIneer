# Knowledge and SOPs
data/*
# 题集进版本控制：nightly/CI 经 import API 幂等导入，基线题集跟随代码版本
# （git 规则：data/ 会排除目录本身导致不下钻，故用 data/* + 逐级豁免）
!data/evals
data/evals/*
!data/evals/datasets
data/evals/datasets/*
!data/evals/datasets/*.json
# 钉住的评测基线快照（compare_runs pin 产出）：基线必须跟代码走，不能只活在某环境 sqlite 里
!data/evals/baseline
data/evals/baseline/*
!data/evals/baseline/*.json
