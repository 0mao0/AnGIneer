# 阶段1: 构建前端应用
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# 国内服务器直连 npm 官方源不稳定，改用 npmmirror
ENV npm_config_registry=https://registry.npmmirror.com

WORKDIR /app

ENV NODE_OPTIONS=--max-old-space-size=2048

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/shared/ apps/shared/
COPY apps/user-web/package.json apps/user-web/
COPY apps/admin-web/package.json apps/admin-web/
COPY packages/ui-kit/package.json packages/ui-kit/
COPY packages/docs-ui/package.json packages/docs-ui/
COPY packages/aichat-ui/package.json packages/aichat-ui/
COPY packages/smartree/package.json packages/smartree/
COPY packages/table-ui/package.json packages/table-ui/
COPY packages/sop-ui/package.json packages/sop-ui/
COPY packages/evals-ui/package.json packages/evals-ui/
COPY packages/geo-ui/package.json packages/geo-ui/
COPY packages/engtools-ui/package.json packages/engtools-ui/

RUN pnpm install --frozen-lockfile

COPY . .

RUN find /app -path "*/node_modules/.bin" -type d -exec chmod -R +x {} + 2>/dev/null; true

RUN pnpm --filter @angineer/user-web build:docker && pnpm --filter @angineer/admin-web build:docker

# 阶段2: Nginx 服务静态文件
FROM nginx:alpine

# nginx:alpine 自带 mime.types 无 .mjs（vite 打包的 pdf.js worker 等 ES module），
# 缺省回退 application/octet-stream 会被浏览器 module script MIME 检查拒绝；补 mjs + wasm。
RUN sed -i 's|application/javascript[[:space:]][[:space:]]*js;|application/javascript                           js mjs;|' /etc/nginx/mime.types \
    && grep -q 'application/wasm' /etc/nginx/mime.types \
       || sed -i '/application\/javascript/a\    application/wasm                            wasm;' /etc/nginx/mime.types

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/user-web/dist /usr/share/nginx/html/web
COPY --from=builder /app/apps/admin-web/dist /usr/share/nginx/html/admin

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
