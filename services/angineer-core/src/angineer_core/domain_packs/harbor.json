{
  "name": "harbor",
  "description": "海港/码头工程（JTS 规范族）领域包：参数释义、工具输出别名、calculator 领域规则、参数提取规则（arg_rules/arg_computes 等，2026-10-12 classifier 深层逻辑外置）。",
  "param_descriptions": {
    "H": "波高（m），常以H4%或H1%形式出现在题面",
    "L": "波长（m）",
    "d": "水深（m），可由设计水位与底高程推算",
    "h": "码头上部结构高度（m）",
    "h0": "波峰面高出上部结构底面的高度（m），波峰低于底面时取0",
    "b": "船宽/B值（m），常通过吨级+船型查附录表A.0.2获取",
    "夹角": "水流方向与航道轴线的夹角（°），由流向+航道方位推算",
    "掩护情况": "码头掩护条件：掩护良好/部分掩护/开敞水域，可从'受顺浪''横浪'等描述推断",
    "K1": "波浪系数：顺浪取0.3，横浪取0.5",
    "k2": "波浪富裕深度折减系数（0~1.0）",
    "折减系数": "波浪富裕深度折减系数（0~1.0）",
    "流速": "水流流速（m/s）",
    "横风风力": "横风风力等级（≤7级为横风，≥7级为大风）",
    "船舶航速": "船舶设计航速（kn）",
    "船舶类型": "航道类型：单线航道或双线航道"
  },
  "output_aliases": {
    "dwl_basic": [
      "design_high_water_level",
      "basic",
      "design"
    ],
    "dwl_extreme": [
      "extreme_high_water_level",
      "extreme"
    ],
    "delta_w_basic": [
      "delta_w_10yr",
      "10yr",
      "10_year",
      "10年",
      "basic"
    ],
    "delta_w_extreme": [
      "delta_w_2yr",
      "2yr",
      "2_year",
      "2年",
      "extreme"
    ],
    "e_basic": [
      "e_basic",
      "basic",
      "10yr",
      "10年"
    ],
    "e_extreme": [
      "e_extreme",
      "extreme",
      "2yr",
      "2年"
    ],
    "t": [
      "满载吃水t",
      "吃水t",
      "design_draft",
      "draft",
      "吃水"
    ],
    "z1": [
      "z1",
      "龙骨下最小富裕深度"
    ],
    "z2": [
      "z2",
      "波浪富裕深度"
    ],
    "z3": [
      "z3",
      "船舶装载纵倾富裕深度",
      "船尾吃水"
    ],
    "z4": [
      "z4",
      "备淤富裕深度"
    ]
  },
  "calculator_hint": "- For K1 (wave coefficient): if wave direction vs dock angle < 45° → K1=0.3 (顺浪), else → K1=0.5~0.7 (横浪).\n- For 折减系数 (reduction factor): 良好掩护→1.0, 部分掩护→(0,1)取中间值如0.5, 开敞→0.",
  "arg_rules": {
    "H4%": {
      "required": {
        "regexes": [
          "H4%\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)",
          "波高\\s*H4%\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ]
      }
    },
    "H": {
      "required": {
        "regexes": [
          "(?:波高|H1%|H4%|H5%|H13%)\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)",
          "(?:重现期|一遇)波高\\s*(?:H1%|H4%)?\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ],
        "markers": [
          "波高为",
          "波高",
          "H4%=",
          "H1%=",
          "H4%为",
          "H1%为"
        ]
      }
    },
    "L": {
      "required": {
        "regexes": [
          "波长\\s*(?:L)?\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ],
        "markers": [
          "波长为",
          "波长",
          "L=",
          "L为"
        ]
      }
    },
    "d": {
      "required": {
        "regexes": [
          "水深\\s*(?:d)?\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ],
        "markers": [
          "水深为",
          "水深"
        ]
      }
    },
    "h": {
      "required": {
        "regexes": [
          "(?:上部结构高度|结构高度)\\s*(?:h)?\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ]
      }
    },
    "h0": {
      "required": {
        "regexes": [
          "波峰面高出上部结构底面的高度\\s*(?:h0)?\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)",
          "h0\\s*[=＝为:]?\\s*([\\d.]+(?:m)?)"
        ]
      }
    },
    "b": {
      "required": {
        "regexes": [
          "(?:船宽|B\\s*[=＝为:])\\s*([\\d.]+(?:m)?)"
        ],
        "markers": [
          "船宽为",
          "船宽",
          "B="
        ]
      }
    },
    "掩护情况": {
      "required": {
        "regexes": [
          "掩护(?:水域|情况|条件)?[为取]?([^，。；;]{1,10})",
          "(部分掩护|掩护良好|开敞水域|开敞式|无掩护)"
        ],
        "markers": [
          "掩护条件为",
          "掩护情况为",
          "掩护条件",
          "掩护情况"
        ]
      },
      "always": {
        "keywords_value": [
          [
            "开敞",
            "开敞水域"
          ]
        ],
        "regex_value": [
          [
            "受[顺横]浪",
            "部分掩护"
          ]
        ]
      }
    },
    "夹角": {
      "required": {
        "regexes": [
          "(?:夹角|交角)\\s*[=＝为:]?\\s*([\\d.]+(?:°|度)?)"
        ],
        "markers": [
          "夹角为",
          "夹角",
          "交角为",
          "交角"
        ]
      }
    },
    "吨级": {
      "required": {
        "regexes": [
          "(\\d+(?:\\.\\d+)?)\\s*吨级",
          "(\\d+(?:\\.\\d+)?)\\s*(?:GT|gt|DWT|dwt)"
        ]
      }
    },
    "起算水位": {
      "required": {
        "regexes": [
          "起算水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)",
          "设计低水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
        ],
        "markers": [
          "起算水位",
          "设计低水位"
        ]
      }
    },
    "底质条件": {
      "required": {
        "regexes": [
          "(?:海底)?底质(?:条件)?(?:为|取)?([^，。；;]+)"
        ],
        "markers": [
          "海底底质为",
          "海底底质",
          "底质条件为",
          "底质为"
        ]
      }
    },
    "回淤条件": {
      "required": {
        "regexes": [
          "回淤条件(?:为|取)?([^，。；;]+)",
          "(有回淤|不淤港口|不淤)"
        ],
        "markers": [
          "回淤条件为",
          "回淤条件"
        ]
      }
    },
    "设计船型": {
      "required": {
        "regexes": [
          "设计船型(?:为|取)?\\s*([^，。；;]{1,15}船)",
          "拟建\\s*(\\d+(?:\\.\\d+)?吨级[^，。；;]{1,15}船)"
        ],
        "markers": [
          "设计船型为",
          "设计船型"
        ]
      }
    },
    "船型": {
      "required": {
        "regexes": [
          "船型(?:为|取)?\\s*([^，。；;]{1,15}船)",
          "通航船舶为\\s*(\\S+船)",
          "船舶为\\s*(\\S+船)"
        ],
        "markers": [
          "船型为",
          "船型"
        ]
      }
    },
    "流速": {
      "required": {
        "regexes": [
          "(?:水流)?流速\\s*[=＝为:]?\\s*([\\d.]+(?:\\s*(?:m/s)?)?)"
        ],
        "markers": [
          "流速为",
          "流速",
          "水流流速为",
          "水流流速"
        ]
      }
    },
    "横风风力": {
      "required": {
        "regexes": [
          "(?:横风|风力)\\s*(?:≤|≤|小于等于|小于|为)?\\s*(\\d+)\\s*(?:级)?"
        ],
        "markers": [
          "横风为",
          "横风",
          "风力为",
          "风力"
        ]
      }
    },
    "船舶航速": {
      "required": {
        "regexes": [
          "航速\\s*[=＝为:]?\\s*([\\d.]+(?:\\s*(?:kn|节)?)?)"
        ],
        "markers": [
          "航速为",
          "航速",
          "船速为",
          "船速"
        ]
      }
    },
    "船舶类型": {
      "required": {
        "regexes": [
          "(单线航道|双线航道|单向航道|双向航道)"
        ],
        "markers": [
          "航道为",
          "航道类型为"
        ]
      },
      "always": {
        "keywords_value": [
          [
            "单线航道",
            "单线航道"
          ],
          [
            "双线航道",
            "双线航道"
          ]
        ]
      }
    },
    "K1": {
      "required": {
        "regexes": [
          "K1\\s*[=＝为:]?\\s*([\\d.]+)"
        ],
        "markers": [
          "K1=",
          "K1为",
          "K1=",
          "K1:"
        ]
      },
      "always": {
        "keywords_value": [
          [
            "顺浪",
            "0.3"
          ],
          [
            "横浪",
            "0.5"
          ]
        ]
      }
    },
    "k2": {
      "required": {
        "regexes": [
          "k2\\s*[=＝为:]?\\s*([\\d.]+)"
        ],
        "markers": [
          "k2=",
          "k2为",
          "k2=",
          "k2:"
        ]
      }
    },
    "折减系数": {
      "required": {
        "regexes": [
          "折减系数\\s*[=＝为取:]?\\s*([\\d.]+)",
          "(?:波浪富裕深度)?折减系数\\s*[=＝为取:]?\\s*([\\d.]+)"
        ],
        "markers": [
          "折减系数为",
          "折减系数取",
          "折减系数"
        ]
      }
    },
    "Z4": {
      "always": {
        "regexes": [
          "备淤(?:富裕)?深度(?:取|为|按)?\\s*([\\d.]+(?:m)?)",
          "Z4(?:取|为|=|＝)?\\s*([\\d.]+(?:m)?)"
        ]
      }
    },
    "设计高水位": {
      "always": {
        "regexes": [
          "设计高水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
        ]
      }
    },
    "设计低水位": {
      "always": {
        "regexes": [
          "设计低水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
        ]
      }
    },
    "土质": {
      "always": {
        "regexes": [
          "(淤泥质土|淤泥质黏土|淤泥|粉质黏土|黏性土|粉土|中砂|粗砂|细砂|砂土|碎石土|岩石)"
        ]
      }
    },
    "状态": {
      "always": {
        "regexes": [
          "(松散|稍密|中密|密实|软塑|可塑|硬塑|坚硬|流塑)"
        ]
      }
    },
    "angle": {
      "always": {
        "regexes": [
          "转向角[^\\d]{0,6}([\\d.]+)\\s*[°度]?",
          "(?:转角|转向角度)[^\\d]{0,6}([\\d.]+)\\s*[°度]?",
          "φ\\s*[=＝为]?\\s*([\\d.]+)"
        ]
      }
    },
    "Hnav": {
      "always": {
        "regexes": [
          "航道设计通航水位(?:为|取|采用)?\\s*([\\-\\d.]+(?:m)?)",
          "设计通航水位(?:为|取|采用)?\\s*([\\-\\d.]+(?:m)?)"
        ]
      }
    },
    "H_nav": {
      "always": {
        "regexes": [
          "航道设计通航水位(?:为|取|采用)?\\s*([\\-\\d.]+(?:m)?)",
          "设计通航水位(?:为|取|采用)?\\s*([\\-\\d.]+(?:m)?)"
        ]
      }
    }
  },
  "arg_computes": [
    {
      "param": "回淤条件",
      "op": "numeric_flag",
      "source": "Z4",
      "gt": 0,
      "true": "有回淤",
      "false": "不淤"
    },
    {
      "param": "d",
      "op": "subtract",
      "minuend_regexes": [
        "设计(?:高|低)水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ],
      "subtrahend_regexes": [
        "(?:码头前沿)?(?:水域)?底高程(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ],
      "round": 2
    },
    {
      "param": "夹角",
      "op": "compass_angle",
      "flow_regex": "流向\\s*([NSEW])\\s*(\\d+)\\s*[°°]",
      "channel_regex": "航道(?:轴线)?方位(?:为|是)?\\s*(\\d+)\\s*[°°]\\s*[~～]\\s*(\\d+)\\s*[°°]"
    },
    {
      "freq_range": [
        90,
        95
      ],
      "single_regexes": [
        "乘潮水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ],
      "param": "Hnav",
      "op": "pick_ts_water"
    },
    {
      "param": "Hnav",
      "op": "fallback_regexes",
      "regexes": [
        "设计低水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ]
    },
    {
      "freq_range": [
        90,
        95
      ],
      "single_regexes": [
        "乘潮水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ],
      "param": "H_nav",
      "op": "pick_ts_water"
    },
    {
      "param": "H_nav",
      "op": "fallback_regexes",
      "regexes": [
        "设计低水位(?:为|取)?\\s*([\\-\\d.]+(?:m)?)"
      ]
    }
  ],
  "arg_defaults": {
    "h0": "0"
  },
  "ship_type_rules": [
    {
      "keywords": [
        "矿石",
        "煤",
        "散粮",
        "散货",
        "干散货"
      ],
      "船型": "散货船",
      "设计船型": "干散货船"
    },
    {
      "keywords": [
        "原油",
        "成品油",
        "油品",
        "液货",
        "液体散货"
      ],
      "船型": "油船",
      "设计船型": "液体散货船"
    },
    {
      "keywords": [
        "集装箱"
      ],
      "船型": "集装箱船",
      "设计船型": "集装箱船"
    },
    {
      "keywords": [
        "滚装",
        "ro-ro",
        "roro"
      ],
      "船型": "滚装船",
      "设计船型": "滚装船"
    },
    {
      "keywords": [
        "化学品"
      ],
      "船型": "化学品船",
      "设计船型": "化学品船"
    },
    {
      "keywords": [
        "水泥"
      ],
      "船型": "散装水泥船",
      "设计船型": "散装水泥船"
    }
  ],
  "stop_markers": [
    "，备淤",
    ",备淤",
    "备淤富裕深度",
    "，计算",
    ",计算",
    "，求",
    ",求",
    "，采用",
    ",采用",
    "，码头结构",
    ",码头结构",
    "，波浪",
    ",波浪",
    "，允许",
    ",允许",
    "，平均周期",
    ",平均周期",
    "，取小数点后",
    ",取小数点后",
    "（",
    "("
  ],
  "clean_rules": {
    "吨级": {
      "op": "first_number"
    },
    "底质条件": {
      "op": "remove_substrings",
      "substrings": [
        "海底",
        "底质条件",
        "底质"
      ],
      "strip": " 为取"
    },
    "船型": {
      "op": "ship_type"
    },
    "设计船型": {
      "op": "ship_type"
    }
  }
}